{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build:citizen": "vite build --config citizen-app/vite.config.ts",
    "build:admin": "vite build --config admin-app/vite.config.ts",
    "build": "npm run build:citizen && npm run build:admin",
    "preview": "vite preview",
    "clean": "rm -rf dist citizen-app/dist admin-app/dist server.js",
    "lint": "tsc --noEmit",
    "lint:rules": "eslint firestore.rules",
    "test": "tsx --test server/__tests__/step1.test.ts firestore.rules.test.ts"
  },
  "dependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@google/genai": "^3.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jpeg-js": "^0.3.0",
    "@types/leaflet": "^1.9.22",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "eslint": "^10.15.0",
    "exifr": "^7.1.3",
    "express": "^4.21.2",
    "firebase": "^13.3.0",
    "firebase-admin": "^14.5.1",
    "jpeg-js": "^0.4.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "otpauth": "^9.6.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
